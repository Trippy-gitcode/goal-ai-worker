          </div>
          <div style="height:5px;background:var(--muted3);border-radius:3px;overflow:hidden;">
            <div style="height:100%;width:${l}%;background:${s.phaseColor};border-radius:3px;transition:width .4s;"></div>
          </div>
        </div>`}).join("")}
    </div>

