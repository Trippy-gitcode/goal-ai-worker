{
  "name": "goal-ai-worker",
  "version": "1.0.0",
  "private": true,
  "description": "GOAL AI — Cloudflare Worker (API Proxy + Token Management)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "deploy:frontend": "vite build && npx wrangler pages deploy frontend-dist --project-name goal-ai-frontend",
    "token:create": "node scripts/create-token.js"
  },
  "devDependencies": {
    "vite": "^8.0.0",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "canvas": "^3.2.1"
  }
}
